<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_mini"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_mini"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_flame_mini"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="streak"
                android:src="@drawable/ic_flame" />

            <TextView
                android:id="@+id/widget_streak_num_mini"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/nunito_extrabold"
                android:text="0"
                android:textColor="#EA580C"
                android:textSize="30sp"
                android:includeFontPadding="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/nunito_bold"
                android:text="dina"
                android:textColor="#F97316"
                android:textSize="13sp"
                android:includeFontPadding="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_tagline_mini"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="@font/nunito_bold"
            android:text="Ayo miwiti dina iki!"
            android:textColor="#9A8B78"
            android:textSize="11sp"
            android:includeFontPadding="false" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_mascot_mini"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="2dp"
        android:contentDescription="maskot Sinau Jowo"
        android:src="@drawable/mascot_happy" />
</FrameLayout>
